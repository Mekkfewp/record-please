{
  "name": "record-please",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-catalog.mjs",
    "test": "node --test \"scripts/*.test.mjs\" \"tests/*.test.mjs\"",
